<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mg4.launcher">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- indicatori Bluetooth e Wi-Fi in alto a destra -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- CarService: pressione pneumatici (TPMS) e temperatura interna -->
    <uses-permission android:name="android.car.permission.CAR_TIRES" />
    <uses-permission android:name="android.car.permission.CAR_ENGINE_DETAILED" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- concessi automaticamente perché l'app è firmata con la chiave platform del sistema -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <!-- avvio all'accensione e riconferma della home predefinita -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_PREFERRED_APPLICATIONS" />
    <!-- attivazione permanente del servizio di accessibilità (concesso dalla firma platform) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- aggiornamento da GitHub senza conferma (permesso di sistema, concesso dalla firma platform) -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- loghi radio dell'utente (cartella MG4Launcher/loghi su memoria o chiavetta): il permesso si concede da solo -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
    <!-- nel log anche i crash dei servizi dell'auto (es. radio), per capirne la causa -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- 0.8.2: riavvio del dongle CarPlay/AA (permesso USB e reset della porta, arresto del servizio Allgo) -->
    <uses-permission android:name="android.permission.MANAGE_USB" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <!-- 0.8.5: firmware SWI68 vecchi, cancella i dati del servizio radio quando crasha sul promemoria DAB rotto -->
    <uses-permission android:name="android.permission.CLEAR_APP_USER_DATA" />
    <!-- 0.8.6-beta: disinstallazione dalle impostazioni, senza computer -->
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/LauncherTheme"
        android:supportsRtl="false"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true">

        <!-- libreria del CarService (presente sull'auto; facoltativa altrove) -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|locale|layoutDirection|density|fontScale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- all'accensione il firmware apre la home MG per nome: questo receiver riporta in primo piano il launcher -->
        <receiver
            android:name=".svc.BootWatcher"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- solo per sapere quale app passa in primo piano all'accensione (nessun contenuto dello schermo) -->
        <service
            android:name=".svc.BootAccessibility"
            android:label="@string/app_name"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_boot" />
        </service>

        <receiver
            android:name=".svc.TokenReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
